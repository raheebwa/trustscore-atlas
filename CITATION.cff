    given-names: Aheebwa
    email: hello@badrama.com
repository-code: https://github.com/raheebwa/trustscore-atlas
url: https://atlas.trustscorehq.com
license: Apache-2.0
version: 0.1.0
keywords:
  - open data
  - business registers
  - provenance
  - data quality
  - Uganda
  - Kenya
